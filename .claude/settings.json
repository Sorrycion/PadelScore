{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/check_manuals.py\"",
            "timeout": 30,
            "statusMessage": "Checking the user manuals are up to date"
          }
        ]
      }
    ]
  }
}
